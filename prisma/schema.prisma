// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String   @unique
  name    String
  contact String?
  password String?
}
model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  lastName  String? 
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  userId    String   @db.ObjectId  // Apenas marca como ObjectId, sem @relation
  isFavorite Boolean  @default(false)
}
